# ============================================================
# MOO-Director 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改
# ============================================================

# 运行模式: local | server
RUN_MODE=local

# 服务端口
PORT=3000

# 数据库配置（本地模式使用 SQLite）
DB_TYPE=sqlite
DB_PATH=./data/moo-director.db

# 服务端模式 MySQL 配置（RUN_MODE=server 时使用，MVP 阶段暂不支持）
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=cineslice_studio

# JWT 密钥（服务端模式必须修改为强随机字符串）
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 文件存储路径
UPLOAD_DIR=./uploads
DATA_DIR=./data

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# ============================================================
# 性能配置
# ============================================================

# 视频生成并发数（默认2，建议1-3）
# VIDEO_CONCURRENCY=2

# AI 生成超时时间（毫秒，默认600000=10分钟）
# AI_TIMEOUT=600000

# ============================================================
# 前端环境变量（VITE_ 前缀会暴露给前端）
# ============================================================
VITE_API_BASE_URL=/api
VITE_RUN_MODE=local
VITE_APP_NAME=CineSlice Studio
